Dialogue: 0,0:00:00.15,0:00:01.89,Ana,,0,0,0,,{\fad(80,80)}Bir kuş için 33 yıl.
Dialogue: 0,0:00:02.39,0:00:02.73,Ana,,0,0,0,,{\fad(80,80)}Bu,
Dialogue: 0,0:00:02.73,0:00:04.06,Ana,,0,0,0,,{\fad(80,80)}lejyonun kartalıydı:
Dialogue: 0,0:00:04.06,0:00:04.63,Ana,,0,0,0,,{\fad(80,80)}aquila.
Dialogue: 0,0:00:04.63,0:00:06.94,Ana,,0,0,0,,{\fad(80,80)}Onu taşıyan askere aquilifer denirdi.
Dialogue: 0,0:00:07.29,0:00:08.36,Ana,,0,0,0,,{\fad(80,80)}Kartalı kaybetmek,
Dialogue: 0,0:00:08.36,0:00:09.80,Ana,,0,0,0,,{\fad(80,80)}bir lejyon için büyük bir
Dialogue: 0,0:00:09.80,0:00:10.36,Ana,,0,0,0,,{\fad(80,80)}utançtı.
Dialogue: 0,0:00:10.71,0:00:11.46,Ana,,0,0,0,,{\fad(80,80)}MÖ 53'te,
Dialogue: 0,0:00:11.46,0:00:13.41,Ana,,0,0,0,,{\fad(80,80)}bugünkü Harran yakınlarında,
Dialogue: 0,0:00:13.41,0:00:15.79,Ana,,0,0,0,,{\fad(80,80)}Crassus'un ordusu Partlara yenildi.
Dialogue: 0,0:00:16.14,0:00:18.02,Ana,,0,0,0,,{\fad(80,80)}Kartallar düşmanın eline geçti;
Dialogue: 0,0:00:18.02,0:00:19.35,Ana,,0,0,0,,{\fad(80,80)}Crassus da öldürüldü.
Dialogue: 0,0:00:19.70,0:00:21.54,Ana,,0,0,0,,{\fad(80,80)}Roma yıllarca bu utançla yaşadı.
Dialogue: 0,0:00:21.89,0:00:23.40,Ana,,0,0,0,,{\fad(80,80)}33 yıl sonra Augustus,
Dialogue: 0,0:00:23.40,0:00:26.13,Ana,,0,0,0,,{\fad(80,80)}savaşmadan ama gücünü göstererek Partlarla
Dialogue: 0,0:00:26.13,0:00:26.80,Ana,,0,0,0,,{\fad(80,80)}anlaştı.
Dialogue: 0,0:00:27.15,0:00:29.26,Ana,,0,0,0,,{\fad(80,80)}Bazı kaynaklara göre kartalları Tiberius
Dialogue: 0,0:00:29.26,0:00:30.00,Ana,,0,0,0,,{\fad(80,80)}teslim aldı.
Dialogue: 0,0:00:30.60,0:00:31.40,Ana,,0,0,0,,{\fad(80,80)}Ve Roma bunu,
Dialogue: 0,0:00:31.40,0:00:33.24,Ana,,0,0,0,,{\fad(80,80)}kazanılmış bir savaş gibi kutladı.
